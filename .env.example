# ---------- App ----------
APP_ENV=development                 # development | production
BASE_URL=http://localhost:8000      # public https URL in production (webhooks + apply redirect)
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=*

# ---------- Database ----------
# Local Docker Compose Postgres:
#   postgresql+asyncpg://jobbot:change-this-strong-password@postgres:5432/jobbot
# Neon (or any managed Postgres) - copy their connection string and change the scheme
# from postgresql:// to postgresql+asyncpg:// ; sslmode=require is handled automatically.
POSTGRES_PASSWORD=change-this-strong-password
DATABASE_URL=postgresql+asyncpg://jobbot:change-this-strong-password@postgres:5432/jobbot
# Local Docker Compose Redis: redis://redis:6379/0
# Upstash (or any managed Redis) - use their rediss:// (TLS) URL, not the redis-cli command.
REDIS_URL=redis://redis:6379/0

# ---------- Telegram ----------
BOT_TOKEN=                          # from @BotFather
TELEGRAM_WEBHOOK_SECRET=            # random 32+ chars (letters, numbers, _ -)
SUPPORT_USERNAME=                   # without @
ADMIN_ALERT_CHAT_ID=                # your Telegram numeric id for error alerts

# ---------- Gemini ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=            # same value as set in Razorpay dashboard webhook

# ---------- Admin auth ----------
JWT_SECRET=                         # random 64+ chars; API refuses to start in production if shorter than 32
JWT_EXPIRE_HOURS=72

# ---------- Files ----------
UPLOAD_DIR=/data/resumes
MAX_RESUME_MB=10

# ---------- Cloudinary (resume storage) ----------
# From cloudinary.com dashboard -> "API Environment variable" (starts with cloudinary://)
# Leave empty to fall back to local disk storage (fine for a single-instance VPS with a
# persistent volume; required on Render/Heroku-style hosts with an ephemeral filesystem).
CLOUDINARY_URL=

# ---------- GhostlyAI.in admin API (sister product, proxied under /admin/ghostly/*) ----------
GHOSTLY_API_BASE_URL=                # e.g. https://xxxx.execute-api.ap-south-1.amazonaws.com/prod
GHOSTLY_API_KEY=                     # their admin API key; never sent to the mobile app directly
GHOSTLY_API_AUTH_HEADER=x-api-key    # header their authorizer expects; change once confirmed
                                     # (e.g. "Authorization" is auto-prefixed with "Bearer ")
